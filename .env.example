# Pooled connection: use for app queries.
DATABASE_URL=postgresql://plantbook:plantbook@localhost:5432/plantbook

# Direct (unpooled) connection: use for migrations and other tools that need a session.
DATABASE_URL_UNPOOLED=postgresql://plantbook:plantbook@localhost:5432/plantbook

# Better Auth. Generate a secret with `npx auth secret` or `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Public origin of the app.
BETTER_AUTH_URL=http://localhost:3000
